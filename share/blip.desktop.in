[Desktop Entry]
Type=Application
Name=Blip
GenericName=Messages
Comment=iMessage on Linux, through your Mac
Exec=@BLIP_APP@
Icon=blip
Terminal=false
# The window belongs to the Omarchy shell's own process (class org.quickshell),
